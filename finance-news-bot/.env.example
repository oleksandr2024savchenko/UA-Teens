# ── Обов'язкові ─────────────────────────────────────────────
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Модель ──────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-5-5
# Окрема модель для швидкого відбору/кластеризації новин (за замовчуванням та сама)
CLAUDE_TRIAGE_MODEL=claude-opus-5-5

# ── Робота конвеєра ─────────────────────────────────────────
# Як часто перевіряти джерела (хвилини)
FETCH_INTERVAL_MIN=10
# Мінімальна важливість (1-10), з якої новина аналізується одразу
ANALYZE_MIN_IMPORTANCE=6
# Скільки нових історій максимум аналізувати за один цикл
MAX_ANALYSES_PER_CYCLE=6
# Новини, старші за N годин, ігноруються
MAX_ARTICLE_AGE_HOURS=24
# Часовий пояс для дайджестів
TIMEZONE=Europe/Kyiv

# ── Адміністрування ─────────────────────────────────────────
# Telegram ID адмінів через кому (для /stats, /refresh, /health)
ADMIN_IDS=
# Шлях до бази SQLite
DB_PATH=./data/bot.db
# Вимкнути окремі джерела (id через кому, див. src/sources.js)
DISABLED_SOURCES=
